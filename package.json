{
  "name": "intelligence-saas-platform",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@isp/web",
    "dev:api": "turbo dev --filter=@isp/api",
    "dev:worker": "turbo dev --filter=@isp/worker",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:isolation": "pnpm --filter @isp/db test:isolation",
    "test:integration": "pnpm --filter @isp/db build && pnpm --filter @isp/queue build && pnpm --filter @isp/queue test:integration && pnpm --filter @isp/api test:integration && pnpm --filter @isp/worker test:integration",
    "start:web": "pnpm --filter @isp/web start",
    "start:api": "pnpm --filter @isp/api start",
    "start:worker": "pnpm --filter @isp/worker start",
    "db:generate": "pnpm --filter @isp/db generate",
    "db:migrate": "pnpm --filter @isp/db migrate",
    "db:bootstrap": "pnpm --filter @isp/db bootstrap",
    "db:status": "pnpm --filter @isp/db status",
    "db:grant-platform-admin": "pnpm --filter @isp/db grant-platform-admin",
    "db:staging-fixture": "pnpm --filter @isp/db staging-fixture",
    "staging:source-smoke": "pnpm --filter @isp/db staging-source-smoke",
    "staging:ingest": "pnpm --filter @isp/db staging-ingest",
    "staging:db-identity": "pnpm --filter @isp/db staging-db-identity",
    "staging:redis-probe": "pnpm --filter @isp/queue staging-redis-probe",
    "test:load-smoke": "pnpm --filter @isp/api exec vitest run src/load.smoke.test.ts",
    "test:security-scan": "pnpm --filter @isp/web exec vitest run lib/security-scan.test.ts"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^5.9.2"
  }
}
