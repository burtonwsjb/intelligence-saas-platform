{
  "name": "intelligence-saas-platform",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@isp/web",
    "dev:api": "turbo dev --filter=@isp/api",
    "dev:worker": "turbo dev --filter=@isp/worker",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:isolation": "pnpm --filter @isp/db test:isolation",
    "start:web": "pnpm --filter @isp/web start",
    "start:api": "pnpm --filter @isp/api start",
    "start:worker": "pnpm --filter @isp/worker start",
    "db:generate": "pnpm --filter @isp/db generate",
    "db:migrate": "pnpm --filter @isp/db migrate",
    "db:bootstrap": "pnpm --filter @isp/db bootstrap",
    "db:status": "pnpm --filter @isp/db status"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^5.9.2"
  }
}
