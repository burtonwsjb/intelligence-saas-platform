{
  "name": "@isp/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "drizzle"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:isolation": "vitest run --config vitest.isolation.config.ts",
    "generate": "drizzle-kit generate",
    "migrate": "tsx src/migrate.ts",
    "bootstrap": "tsx src/bootstrap.ts",
    "status": "tsx src/status.ts",
    "grant-platform-admin": "tsx src/grant-platform-admin.ts",
    "staging-fixture": "tsx src/staging-fixture.ts",
    "staging-source-smoke": "tsx src/staging-source-smoke.ts",
    "staging-ingest": "tsx src/staging-ingest.ts",
    "staging-db-identity": "tsx src/staging-db-identity.ts"
  },
  "dependencies": {
    "@isp/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@isp/config": "workspace:*",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.32.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
