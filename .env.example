# Variable names only. Copy to a local untracked .env if needed.
# Do not put secrets in this file or in git.
# AUTH_EMAIL_MODE local values: file (default), log, fixture. Production requires Resend (fail-closed).
# PLATFORM_ADMIN_EMAILS is a non-production allowlist only. Hosted environments use platform_admins rows.
# ISP_ENV: local | test | staging | production. Hosted Node (NODE_ENV=production) is production unless ISP_ENV=staging.

